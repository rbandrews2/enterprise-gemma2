  {
    "displayName": "WZOS staging service 5xx errors",
    "combiner": "OR",
    "enabled": true,
    "userLabels": {
      "wzos_scope": "restricted-staging"
    },
    "conditions": [
      {
        "displayName": "At least 3 server errors in a five-minute window",
        "conditionThreshold": {
          "filter": "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"wzos-v2-accounts\" AND resource.labels.location=\"us-central1\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.labels.response_code_class=\"5xx\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 2,
          "duration": "0s",
          "aggregations": [
            {
              "alignmentPeriod": "300s",
              "perSeriesAligner": "ALIGN_SUM",
              "crossSeriesReducer": "REDUCE_SUM"
            }
          ],
          "trigger": {
            "count": 1
          }
        }
      }
    ],
    "documentation": {
      "content": "Inspect restricted staging Cloud Run request logs and database availability. Excludes expected authentication/client failures. No automatic rollback or changes to V1. Notification delivery pending recipient configuration.",
      "mimeType": "text/markdown"
    },
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "notificationChannels": []
  }
]
