# New dependency image: must pass scan and release gates before traffic.
FROM us-central1-docker.pkg.dev/enterprise-gemma2/enterprise-gemma2/wzos-v2-accounts@sha256:ef31216bc772a0233b7c59a9e219dcd9b17f6c6f2c8ed058270a9a009676ab9d
USER root
# Preserve the reviewed dependency graph; Stripe's dependencies already exist.
# Never resolve/upgrade the existing auth/storage dependencies during this build.
RUN pip install --no-cache-dir --no-deps stripe==15.6.0 && pip check
COPY services /app/services
COPY shared /app/shared
COPY knowledge/billing/v2-stripe-catalog.json /app/knowledge/billing/v2-stripe-catalog.json
RUN chmod -R a+rX /app/services /app/shared /app/knowledge/billing
USER wzos
RUN python -c "from services.workspace_preview.commerce_runtime import register; from stripe import StripeClient; from cryptography.fernet import Fernet; import importlib.metadata as m; assert m.version('stripe') == '15.6.0'"
