{
  "id": "/",
  "name": "Work Zone OS",
  "short_name": "WZOS",
  "description": "Work Zone OS powered by Atlas AI Assistant",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08090b",
  "theme_color": "#08090b",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://app.workzoneos.org/manifest.webmanifest",
      "id": "https://app.workzoneos.org/"
    }
  ],
  "icons": [
    {
      "src": "/install-icon-192.png?brand=20261020",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/install-icon-512.png?brand=20261020",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/install-maskable-192.png?brand=20261020",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/install-maskable-512.png?brand=20261020",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "categories": [
    "business",
    "productivity"
  ]
}
