# Official linux/amd64 Python3.12 base inspected October15; no mutable latest tag.
FROM python:3.12-slim-trixie@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe
WORKDIR /app
COPY requirements-v2.txt requirements-accounts.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install --no-cache-dir -r requirements-accounts.txt
COPY services ./services
COPY shared ./shared
COPY knowledge ./knowledge
RUN useradd --create-home --uid 10001 wzos && mkdir -p /app/.local-data && chown wzos /app/.local-data \
    && chmod -R a+rX /app/services /app/shared /app/knowledge
USER wzos
ENV WZOS_ACCOUNT_WORKSPACE=1
CMD ["sh", "-c", "exec uvicorn services.workspace_preview.account_app:application --factory --host 0.0.0.0 --port ${PORT:-8080}"]
